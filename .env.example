# â”€â”€â”€ Application â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# FastAPI / Uvicorn
ENVIRONMENT=development
LOG_LEVEL=INFO
# json (default, required in Compose/K8s) | console (local readability only)
LOG_FORMAT=json

# PostgreSQL. Compose builds the backend's DATABASE_URL from these three, so
# the password lives in one place. Change it; keep it URL-safe (letters, digits).
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=changeme

# Only for running the backend *outside* Docker. Inside Compose these are
# overridden with the service names (postgres, redis), never localhost.
DATABASE_URL=postgresql+asyncpg://civicpulse:changeme@localhost:5432/civicpulse
REDIS_URL=redis://localhost:6379/0

# â”€â”€â”€ AI Triage â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Provider: llm (hosted Groq) | ollama | rules | simulated
# ollama needs the "ollama" Compose profile (COMPOSE_PROFILES below).
TRIAGE_PROVIDER=ollama

# SimulatedTriage only: deterministic seed and failure injection for CI and demos.
# Mode: none | timeout | rate_limited | server_error | bad_request | error | invalid
SIMULATED_SEED=42
SIMULATED_FAILURE_MODE=none
SIMULATED_FAILURE_RATE=1.0
# Artificial delay per call, for demos (loading state, SIGTERM drain, load tests)
SIMULATED_LATENCY_MS=0

# Resilience: hard cap per provider call, and base delay for the single jittered retry
TRIAGE_TIMEOUT_SECONDS=10
TRIAGE_RETRY_BASE_SECONDS=0.5
# Worker threads reserved for provider calls (a hung provider cannot starve the app)
TRIAGE_MAX_CONCURRENCY=16
REDIS_AI_CACHE_TTL=86400

# Groq LLM (required when TRIAGE_PROVIDER=llm). Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (TRIAGE_PROVIDER=ollama). Compose sets OLLAMA_BASE_URL=http://ollama:11434.
OLLAMA_MODEL=llama3.2:1b

# â”€â”€â”€ Rate Limiting â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Requests per window per IP
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
# Proxies allowed to set X-Forwarded-For (IPs/CIDRs, comma-separated). Anyone
# else's header is ignored, so clients cannot spoof their IP past the rate
# limiter. Compose sets this to the frontend's fixed address; Kubernetes to the
# Ingress controller's pod CIDR.
FORWARDED_ALLOW_IPS=127.0.0.1

# â”€â”€â”€ Stats Cache â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

REDIS_STATS_TTL=30

# â”€â”€â”€ CORS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Comma-separated browser origins allowed to call the API directly. The app
# itself goes through the nginx (or Vite dev server) proxy on the same origin,
# so it needs none of these.
ALLOWED_ORIGINS=http://localhost:5173

# â”€â”€â”€ Docker Compose â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# "ollama" starts the local model server (about 1.3 GB of weights on first run).
# Empty it (COMPOSE_PROFILES=) and set TRIAGE_PROVIDER=rules for a light stack.
COMPOSE_PROFILES=ollama

# Host ports (compose.yaml)
FRONTEND_PORT=8080
BACKEND_PORT=8000

# compose.prod.yaml only: the images to run. Always an immutable commit SHA,
# never :latest (ADR 0003). Left empty on purpose: compose.prod.yaml refuses to
# start until it is set, e.g. IMAGE_TAG=$(git rev-parse HEAD).
REGISTRY=ghcr.io/includeduck/scd-civicpulse
IMAGE_TAG=
