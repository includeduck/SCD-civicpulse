# ─── Application ─────────────────────────────────────────────────────────────

# FastAPI / Uvicorn
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=changeme-at-least-32-characters-long

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql+asyncpg://civicpulse:changeme@postgres:5432/civicpulse

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ─── AI Triage ───────────────────────────────────────────────────────────────

# Provider: llm:groq | llm:ollama | rules | simulated
TRIAGE_PROVIDER=simulated

# Groq LLM (required when TRIAGE_PROVIDER=llm:groq)
GROQ_API_KEY=

# Ollama (required when TRIAGE_PROVIDER=llm:ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ─── Rate Limiting ────────────────────────────────────────────────────────────

# Requests per window per IP
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Stats Cache ──────────────────────────────────────────────────────────────

STATS_CACHE_TTL_SECONDS=30

# ─── CORS ────────────────────────────────────────────────────────────────────

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ─── Docker Image (used by compose.prod.yaml) ─────────────────────────────────

IMAGE_TAG=ghcr.io/includeduck/scd-civicpulse/backend:latest
FRONTEND_IMAGE_TAG=ghcr.io/includeduck/scd-civicpulse/frontend:latest
