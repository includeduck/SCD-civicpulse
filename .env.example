# ─── Application ─────────────────────────────────────────────────────────────

# FastAPI / Uvicorn
ENVIRONMENT=development
LOG_LEVEL=INFO
# json (default, required in Compose/K8s) | console (local readability only)
LOG_FORMAT=json
SECRET_KEY=changeme-at-least-32-characters-long

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql+asyncpg://civicpulse:changeme@postgres:5432/civicpulse

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ─── AI Triage ───────────────────────────────────────────────────────────────

# Provider: llm (hosted Groq) | ollama | rules | simulated
TRIAGE_PROVIDER=simulated

# SimulatedTriage only: deterministic seed and failure injection for CI and demos.
# Mode: none | timeout | rate_limited | server_error | bad_request | error | invalid
SIMULATED_SEED=42
SIMULATED_FAILURE_MODE=none
SIMULATED_FAILURE_RATE=1.0

# Resilience: hard cap per provider call, and base delay for the single jittered retry
TRIAGE_TIMEOUT_SECONDS=10
TRIAGE_RETRY_BASE_SECONDS=0.5
REDIS_AI_CACHE_TTL=86400

# Groq LLM (required when TRIAGE_PROVIDER=llm). Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (required when TRIAGE_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# ─── Rate Limiting ────────────────────────────────────────────────────────────

# Requests per window per IP
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# ─── Stats Cache ──────────────────────────────────────────────────────────────

REDIS_STATS_TTL=30

# ─── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed browser origins

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ─── Docker Image (used by compose.prod.yaml) ─────────────────────────────────

# Always an immutable commit SHA — never :latest (ADR 0003)
IMAGE_TAG=ghcr.io/includeduck/scd-civicpulse/backend:<commit-sha>
FRONTEND_IMAGE_TAG=ghcr.io/includeduck/scd-civicpulse/frontend:<commit-sha>
