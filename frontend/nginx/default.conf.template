# Rendered at container start by the nginx image's entrypoint (envsubst):
# ${BACKEND_URL} comes from the environment, so one image serves every
# environment. Only variables that are actually set are substituted, so
# nginx's own $variables below are left alone. See ADR 0002.

# Keep the caller's X-Request-ID, or mint one, so the backend's logs line up.
map $http_x_request_id $civicpulse_request_id {
    default $http_x_request_id;
    ""      $request_id;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # The API: same origin for the browser, so no CORS and no backend URL in the bundle.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $civicpulse_request_id;
        # Triage can take a timeout, a retry and a fallback (about 21 s worst case).
        proxy_read_timeout 60s;
        client_max_body_size 64k;
    }

    # nginx's own liveness, independent of the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build output never changes, so cache it for a long time.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Client-side routes (/dashboard, /stats) all load index.html, which is never cached.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
